# Environment Variables for Transport AR Installation
# Copy this file to .env and fill in your values

# GTFS-Realtime Feed URLs
GTFS_REALTIME_VEHICLE_POSITIONS_URL=https://your-agency.com/gtfs-rt/vehicle-positions
GTFS_REALTIME_TRIP_UPDATES_URL=https://your-agency.com/gtfs-rt/trip-updates
GTFS_REALTIME_SERVICE_ALERTS_URL=https://your-agency.com/gtfs-rt/service-alerts

# API Keys (if required by your transit agency)
GTFS_API_KEY=your-api-key-here
TRANSIT_AGENCY_API_KEY=your-api-key-here

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
PORT=8080

# Database/Cache (if using)
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://user:password@localhost:5432/transit

# AR Framework Settings (customize as needed)
AR_DISPLAY_MODE=overlay
AR_UPDATE_RATE=30

# Geographic Center (for initial view)
DEFAULT_CENTER_LAT=37.7749
DEFAULT_CENTER_LON=-122.4194
DEFAULT_ZOOM=13

# Performance Tuning
MAX_WORKERS=4
CACHE_ENABLED=true
REQUEST_TIMEOUT=10
